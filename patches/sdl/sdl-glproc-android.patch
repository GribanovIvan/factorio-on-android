@@ -40,6 +40,29 @@
 #include "SDL_egl_c.h"
 #include "../SDL_hints_c.h"
 
+#ifdef SDL_VIDEO_DRIVER_ANDROID
+/* Factorio android port: the game asks SDL for a desktop OpenGL 3.3 core
+ * context.  Android EGL only offers OpenGL ES, so rewrite that request once,
+ * before the GL library is chosen and before the EGL config/context is made.
+ * The compatibility layer in libGLCompat.so then presents the ES context as
+ * desktop GL 3.3 to the game's GLAD loader. */
+static void SDL_EGL_AndroidDesktopGLCompat(SDL_VideoDevice *_this)
+{
+    if (!_this) {
+        return;
+    }
+    if (_this->gl_config.profile_mask != SDL_GL_CONTEXT_PROFILE_ES &&
+        _this->gl_config.major_version >= 3) {
+        SDL_Log("glcompat: context clamp: desktop GL %d.%d profile_mask=0x%x -> EGL OpenGL ES 3.2",
+                _this->gl_config.major_version, _this->gl_config.minor_version,
+                _this->gl_config.profile_mask);
+        _this->gl_config.profile_mask = SDL_GL_CONTEXT_PROFILE_ES;
+        _this->gl_config.major_version = 3;
+        _this->gl_config.minor_version = 2;
+    }
+}
+#endif
+
